# ─────────────────────────────────────────────────────────────
# InsightPulse backend configuration
# Copy to `.env` and fill in what you have. EVERYTHING IS OPTIONAL.
# With zero keys the app runs in Simulation Mode: all 9 connectors
# serve deterministic synthetic findings and the heuristic reasoner
# replaces Claude. Nothing crashes, the whole loop still demos.
# ─────────────────────────────────────────────────────────────

# ── Core ────────────────────────────────────────────────────
APP_ENV=development
# Generate one: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me
# SQLite by default. For Postgres:
#   postgresql+psycopg://user:pass@host:5432/insightpulse
DATABASE_URL=sqlite:///./data/insightpulse.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── LLM (Claude) ────────────────────────────────────────────
# Leave blank to force the deterministic fallback reasoner.
ANTHROPIC_API_KEY=
# Preferred model. The client verifies it against /v1/models on boot and
# falls back to the best available model if this id is not offered.
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_CHEAP_MODEL=claude-haiku-4-5
# Cost governor (USD). Breach → cheaper model → heuristic fallback.
LLM_RUN_BUDGET_USD=0.50
LLM_DAILY_BUDGET_USD=5.00

# ── Agent behaviour ─────────────────────────────────────────
# Force synthetic sources even when keys exist (great for offline demos)
SIMULATION_MODE=false
DEFAULT_INTERVAL_MINUTES=180
SCHEDULER_ENABLED=true
MAX_RESULTS_PER_SOURCE=12
COLLECT_TIMEOUT_SECONDS=25
NEAR_DUPLICATE_THRESHOLD=0.88
EMBEDDING_DIM=512
# hashing | voyage | openai
EMBEDDING_PROVIDER=hashing

# ── Source APIs (all optional) ──────────────────────────────
SEMANTIC_SCHOLAR_API_KEY=
NEWSAPI_KEY=
GNEWS_API_KEY=
# Free key: https://patentsview.org/apis/keyrequest
PATENTSVIEW_API_KEY=
SERPAPI_KEY=
GITHUB_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=python:insightpulse.agent:2.0 (research intelligence agent)

# ── Optional embedding providers ────────────────────────────
VOYAGE_API_KEY=
OPENAI_API_KEY=

# ── Alert delivery (optional) ───────────────────────────────
ALERT_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=insightpulse@localhost
SMTP_STARTTLS=true

# ── Demo bootstrap ──────────────────────────────────────────
SEED_ON_STARTUP=true
DEMO_USER_EMAIL=analyst@insightpulse.dev
DEMO_USER_PASSWORD=insightpulse
